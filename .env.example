# ==============================================================================
# QNX-Aegis: Configuration Template
# Copy this file to .env and adjust variables to match your environment.
# ==============================================================================

# --- QNX SDP 8.0 Environment Paths ---
# Path to QNX SDP 8.0 environment script on Windows host
QNX_SDP_PATH=C:/QNX800/qnxsdp-env.bat
# Target cross-compiler architecture: -Vgcc_ntox86_64 or -Vllvm_ntox86_64
QNX_COMPILER_TARGET=gcc_ntox86_64

# --- QNX Target QEMU SSH Connection ---
# IP or hostname of the running QNX 8.0 QEMU instance
QEMU_HOST=127.0.0.1
# Forwarded SSH port (commonly 2222 for QEMU hostfwd, or 22 for direct bridge)
QEMU_SSH_PORT=2222
# Default QNX credentials
QEMU_SSH_USER=qnxuser
QEMU_SSH_PASSWORD=qnxuser
# Optional SSH Private Key path (leave blank if using password authentication)
QEMU_SSH_KEY_PATH=

# Directory on the QNX target where binaries and inspector daemon are placed
QEMU_DEPLOY_DIR=/tmp/qnx-aegis

# --- QNX Target QEMU Process Configuration ---
# Path to host QEMU x86_64 emulator executable
QEMU_BIN_PATH=D:/qemu/qemu-system-x86_64.exe
# Path to QNX 8.0 raw disk image
QEMU_DISK_IMAGE=D:/QNX_VM/qemu/output/disk-qemu
QEMU_MEMORY_MB=1024
QEMU_SMP=2

# --- Host MCP Server & API Bridge ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080
API_BRIDGE_HOST=0.0.0.0
API_BRIDGE_PORT=8000

# Telemetry Poll Frequency (in seconds)
TELEMETRY_POLL_INTERVAL=2.0

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
